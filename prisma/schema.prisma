// Taco Oasis Floor Boards — SQLite schema (SPEC §6)
// Note: SQLite has no native enums; board/ability stored as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id               String                   @id @default(cuid())
  externalId       String                   @unique
  firstName        String
  lastName         String
  email            String?
  shifts           Shift[]
  abilities        EmployeeStationAbility[]
  tareaAssignments TareaAssignment[]
  returnPrompts    ReturnPrompt[]
  positionMoves    PositionMoveLog[]
  performanceAnswers PerformanceAnswer[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model Station {
  id            String                   @id
  board         String // caja | cocina
  label         String
  color         String
  maxConcurrent Int // -1 = unlimited
  sortOrder     Int
  priority      Int?
  /// Schedule-grid short code (FRY, G1). Empty falls back to the seeded map.
  shortCode     String   @default("")
  abilities     EmployeeStationAbility[]
  assignments   Assignment[]
  positionMaps  PositionStationMap[]
}

/// Planner G: the When I Work position string a shift imports as, mapped to
/// the station Colocar fijos should place it on. A null stationId (or the
/// row being absent) both mean "do not place" — set in Back office.
model PositionStationMap {
  position  String   @id
  stationId String?
  station   Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
}

model Shift {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  date           String // YYYY-MM-DD in America/Chicago
  startAt        DateTime
  endAt          DateTime
  sourcePosition String
  board          String // caja | cocina | other
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  /// Set when a later import replaced or removed this shift (C1). A superseded
  /// shift keeps its started, assigned hours as history and takes no new future hour.
  supersededAt        DateTime?
  supersededByBatchId String?
  /// Preserve staff hiding on a superseded source row after its override
  /// becomes a tombstone or relinks to a newer occurrence.
  boardRemoved         Boolean @default(false)
  assignments    Assignment[]
  removalOverride ShiftRemoval?

  @@index([date, board])
  @@index([employeeId, date])
}

/// Board-owned visibility of one imported shift occurrence. This is not a
/// When I Work edit. A missing current shift leaves a tombstone for an exact,
/// unambiguous later reappearance, or a manager can auditably retire it.
model ShiftRemoval {
  id                String   @id @default(cuid())
  shiftId           String?  @unique
  shift             Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  externalId        String
  date              String
  board             String
  sourcePosition    String
  startAt           DateTime
  endAt             DateTime
  state             String   @default("removed") // removed | restored | resolved
  revision          Int      @default(1)
  /// Future station cells cleared by the latest removal; JSON is validated
  /// before replay and never sent to the staff board.
  cellsJson         String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  events            ShiftRemovalEvent[]

  @@index([date, board, state])
  @@index([externalId, date, sourcePosition])
}

/// Append-only manager and import history for a board removal.
model ShiftRemovalEvent {
  id            String       @id @default(cuid())
  overrideId    String
  override      ShiftRemoval @relation(fields: [overrideId], references: [id])
  action        String       // remove | restore | resolve | changed | relink | source-missing
  revision      Int          // resulting override revision
  managerId     String?      // null for import-owned source changes and relinks
  managerName   String?
  reason        String
  sourceJson    String
  cellsJson     String
  createdAt     DateTime     @default(now())

  @@index([overrideId, createdAt])
  @@unique([overrideId, revision])
}

model Assignment {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  /// Denormalized from Shift so SQLite can enforce one person per hour.
  /// Nullable only while upgrading a legacy database; new writes always populate it.
  employeeId String?
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])
  hourStart DateTime
  hourEnd   DateTime
  /// Paint order in a numbered family at this hour. Empty on a legacy row until the next write.
  seatNumber Int?

  @@unique([stationId, hourStart])
  @@unique([employeeId, hourStart])
  @@index([shiftId])
}

model EmployeeStationAbility {
  employeeId String
  stationId  String
  level      String // forbidden | training | ok | preferred
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  station    Station  @relation(fields: [stationId], references: [id])

  @@id([employeeId, stationId])
}

model ImportBatch {
  id         String   @id @default(cuid())
  filename   String
  /// Stable hash of parsed schedule rows. Makes a repeated upload idempotent.
  // Nullable during non-destructive legacy upgrade; every new import writes it.
  fingerprint String? @unique
  importedAt DateTime @default(now())
  rowCount   Int
  shifts     Shift[]
}

/// Day notes scoped to board + date (Stage 3). Author label is always "Manager".
model ManagerNote {
  id        String   @id @default(cuid())
  board     String // caja | cocina
  date      String // YYYY-MM-DD America/Chicago
  body      String
  author    String   @default("Manager")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([board, date])
}

/// Singleton row (id = "default") for fake order-traffic simulator.
model TrafficSimulatorConfig {
  id         String    @id @default("default")
  enabled    Boolean   @default(false)
  lastTickAt DateTime?
  updatedAt  DateTime  @updatedAt
}

/// Per load-station busyness from the fake simulator (caja + cocina ids).
model LoadStationMeter {
  loadStationId String   @id
  level         String   @default("quiet") // quiet | busy | slammed
  orderCount    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

/// Homework-style tarea template (board-scoped catalog).
model TareaTemplate {
  id                String            @id
  code              String            @unique
  label             String
  mode              String // normal | backlog_when_slow
  sortOrder         Int
  board             String            @default("caja") // caja | cocina
  lemonWarnOnGreens Boolean           @default(false)
  assignments       TareaAssignment[]
}

/// Multi active OK; status working | done.
model TareaAssignment {
  id           String        @id @default(cuid())
  date         String // YYYY-MM-DD America/Chicago
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId   String
  template     TareaTemplate @relation(fields: [templateId], references: [id])
  status       String        @default("working") // working | done
  forceLemon   Boolean       @default(false)
  assignedAt   DateTime      @default(now())
  completedAt  DateTime?
  unassignedAt DateTime? // set when return-to-station auto-clears

  @@index([date, status])
  @@index([employeeId, date])
}

/// Visual return-to-station prompt (optional chime is client-side).
model ReturnPrompt {
  id            String    @id @default(cuid())
  date          String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loadStationId String
  seatId        String
  message       String
  createdAt     DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([date, acknowledgedAt])
}

/// Logged when moving someone off a station (reason required).
model PositionMoveLog {
  id            String   @id @default(cuid())
  date          String
  hour          Int
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromStationId String?
  toStationId   String?
  assignmentId  String?
  reason        String // Break | Cover expo | Training | Help slammed | Other
  note          String?
  createdAt     DateTime @default(now())

  @@index([date, employeeId])
}

/// End-of-shift / close-day survey question catalog (minimal v1).
model PerformanceQuestion {
  id        String              @id
  prompt    String
  kind      String // free_text | yes_no | scale_1_5
  sortOrder Int
  active    Boolean             @default(true)
  answers   PerformanceAnswer[]
}

/// Stored manager answers for a person on a board date.
model PerformanceAnswer {
  id         String               @id @default(cuid())
  date       String // YYYY-MM-DD
  board      String // caja | cocina
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  questionId String
  question   PerformanceQuestion  @relation(fields: [questionId], references: [id])
  value      String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([date, board, employeeId, questionId])
  @@index([date, board])
}

/// Sample historical sales dollars (cents) by board, weekday, and hour.
/// Rush math converts each sample week into a percent of that day’s sales.
/// Not order counts and not a live POS feed.
/// Seeded from fixtures/historical-hourly-sales.json (values are dollars).
///
/// LATER (not built): compare tareas done — dishwashing, opening, closing —
/// against these slow vs busy hours. See docs/LATER-tarea-vs-rush.md.
model HistoricalHourlySale {
  id         String @id @default(cuid())
  board      String // caja | cocina
  dow        Int // 0 = Sunday … 6 = Saturday
  hour       Int // 7–21
  week       Int
  salesCents Int

  @@unique([board, dow, hour, week])
  @@index([board, dow, hour])
}

/// Floor manager identity. Access codes stored as SHA-256 hashes only.
model Manager {
  id        String   @id @default(cuid())
  name      String
  codeHash  String
  active    Boolean  @default(true)
  /// Planning code: unlock returns LONG_MANAGER_IDLE_MS instead of MANAGER_IDLE_MS. Off for every existing manager.
  longIdle  Boolean  @default(false)
  /// owner | manager. Any stored value other than the exact string owner fails closed.
  role      String   @default("manager")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// One row per successful board write. Written in the same transaction as that write.
/// summary is a machine line (day, hour, station, count), never request prose.
model BoardChangeLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  managerId   String
  managerName String
  route       String
  date        String
  summary     String

  @@index([date, createdAt])
  @@index([createdAt])
}

/// One extra mandatory cocina station for a single date. The three standing
/// stations are not rows here; they stay in code. Old dates are left as written.
model MandatoryMark {
  id        String   @id @default(cuid())
  board     String
  date      String
  stationId String
  createdAt DateTime @default(now())
  managerId String

  @@unique([board, date, stationId])
  @@index([date])
}

/// One Habilidades column rule. A person with no ability row uses defaultLevel.
/// The install seed writes these rows only. It never writes an ability row.
model AbilityColumnSetting {
  key          String   @id
  hidden       Boolean  @default(false)
  /// ok | forbidden. ok is Nuevos bien. forbidden is Nuevos no.
  defaultLevel String
  updatedAt    DateTime @updatedAt
}

/// One salted scrypt passcode for a staff member. No API returns these fields.
model StaffPasscode {
  employeeId String   @id
  hash       String
  salt       String
  updatedAt  DateTime @updatedAt
}

/// One break block for one person on one Chicago date. A second save replaces it.
model StaffBreak {
  id         String   @id @default(cuid())
  employeeId String
  shiftId    String
  board      String
  date       String
  startAt    DateTime
  endAt      DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  actor      String
  /// booked takes a spot. pending waits for a cover and takes none.
  status     String   @default("booked")
  coverEmployeeId String?
  coverShiftId    String?

  @@unique([employeeId, date])
  @@index([board, date])
}

/// One row. saveBreak writes it before reading other breaks, so two tablets cannot both win a slot.
model StaffBreakLock {
  id        Int      @id
  updatedAt DateTime @updatedAt
}

/// One keypad pause per board. Five wrong codes in 15 minutes pause that board for 60 seconds.
model StaffPasscodeAttempt {
  board       String    @id
  failures    Int
  windowStart DateTime
  lockedUntil DateTime?
}
